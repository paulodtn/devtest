<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NeoGenomica - Login</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    }

    .glow-effect {
      box-shadow: 0 0 15px rgba(0, 214, 228, 0.5);
    }

    .input-field:focus {
      box-shadow: 0 0 0 3px rgba(0, 214, 228, 0.3);
    }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
  <div class="relative w-full max-w-md z-10">
    <div class="bg-slate-800/90 backdrop-blur-md rounded-2xl shadow-xl overflow-hidden border border-slate-700/50">
      <!-- Header -->
      <div class="p-8 text-center">
        <h1 class="text-3xl font-bold text-white mb-2">NeoGenomica</h1>
        <p class="text-slate-300">Acesso ao sistema de análise genômica</p>
      </div>

      <!-- Form -->
      <form class="px-8 pb-8">
        <div class="space-y-5">
          <div>
            <label for="username" class="block text-sm font-medium text-slate-300 mb-1">Usuário</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <i class="fas fa-user text-slate-400"></i>
              </div>
              <input type="text" id="username" name="username"
                     class="input-field w-full pl-10 pr-4 py-3 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:border-[#00D6E4] transition duration-200"
                     placeholder="Digite seu usuário" required>
            </div>
          </div>

          <div>
            <label for="password" class="block text-sm font-medium text-slate-300 mb-1">Senha</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <i class="fas fa-lock text-slate-400"></i>
              </div>
              <input type="password" id="password" name="password"
                     class="input-field w-full pl-10 pr-4 py-3 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:border-[#00D6E4] transition duration-200"
                     placeholder="Digite sua senha" required>
              <button type="button" class="absolute right-3 top-3 text-slate-400 hover:text-[#00D6E4]" id="togglePassword">
                <i class="fas fa-eye"></i>
              </button>
            </div>
          </div>

          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <input id="remember-me" name="remember-me" type="checkbox"
                     class="h-4 w-4 rounded border-slate-600 bg-slate-700 text-[#00D6E4] focus:ring-[#00D6E4]">
              <label for="remember-me" class="ml-2 block text-sm text-slate-300">Lembrar-me</label>
            </div>
            <div class="text-sm">
              <a href="#" class="font-medium text-[#00D6E4] hover:text-[#00b8c4]">Esqueceu a senha?</a>
            </div>
          </div>

          <div>
            <button type="submit"
                    class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-[#00D6E4] hover:bg-[#00b8c4] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#00D6E4] transition duration-200 glow-effect">
              Entrar
            </button>
          </div>
        </div>
      </form>

      <!-- Data/Hora -->
      <div class="text-center text-sm text-slate-400 mt-4">
        <p>Último acesso: <%= Time.now.strftime("%d/%m/%Y %H:%M") %></p>
      </div>

      <!-- Footer -->
      <div class="px-8 py-4 bg-slate-800/50 text-center border-t border-slate-700/50">
        <p class="text-xs text-slate-400">
          © 2025 NeoGenomica. Todos os direitos reservados.
          <br>
          <a href="#" class="hover:text-[#00D6E4]">Política de privacidade</a> |
          <a href="#" class="hover:text-[#00D6E4]">Termos de uso</a>
        </p>
      </div>
    </div>

    <div class="mt-6 text-center">
      <p class="text-sm text-slate-400">
        Novo na plataforma?
        <a href="#" class="font-medium text-[#00D6E4] hover:text-[#00b8c4]">Solicite acesso</a>
      </p>
    </div>
  </div>

  <script>
    // Toggle password visibility
    document.getElementById('togglePassword').addEventListener('click', function () {
      const passwordInput = document.getElementById('password');
      const icon = this.querySelector('i');

      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
      } else {
        passwordInput.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
      }
    });

    // Simulate login action (apenas visual)
    document.querySelector('form').addEventListener('submit', function (e) {
      e.preventDefault();
      const username = document.getElementById('username').value;
      const password = document.getElementById('password').value;

      const submitBtn = this.querySelector('button[type="submit"]');
      submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Autenticando...';
      submitBtn.disabled = true;

      setTimeout(() => {
        submitBtn.innerHTML = 'Entrar';
        submitBtn.disabled = false;
        if (username && password) {
          alert('Login bem-sucedido! Redirecionando...');
          // window.location.href = '/dashboard'; // ou sua rota real
        }
      }, 1500);
    });
  </script>
</body>
</html>
